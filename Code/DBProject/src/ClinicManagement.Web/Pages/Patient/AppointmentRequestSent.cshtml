@page
@model ClinicManagement.Web.Pages.Patient.AppointmentRequestSentModel
@{
    ViewData["Title"] = "Appointment Request Sent";
    Layout = "_PatientLayout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow">
            <div class="card-body py-5">
                <i class="fas fa-check-circle fa-5x text-success mb-4"></i>
                <h3>Appointment Request Sent!</h3>
                <p class="text-muted">Your appointment request has been sent to the doctor. You will be notified once it is approved.</p>
                <a href="/Patient/PatientHome" class="btn btn-primary mt-3">
                    <i class="fas fa-home"></i> Go to Home
                </a>
            </div>
        </div>
    </div>
</div>
