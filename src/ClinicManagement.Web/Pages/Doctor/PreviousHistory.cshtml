@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Patient History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-history me-2"></i>Patient History</h2>
    <a asp-page="/Doctor/DoctorHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (!Model.History.Any())
{
    <div class="alert alert-info">No patient history found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Patient</th>
                    <th>Disease</th>
                    <th>Progress</th>
                    <th>Prescription</th>
                    <th>Bill</th>
                    <th>Bill Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.History)
                {
                    <tr>
                        <td>@h.Date?.ToString("yyyy-MM-dd")</td>
                        <td>@h.PatientName</td>
                        <td>@h.Disease</td>
                        <td>@h.Progress</td>
                        <td>@h.Prescription</td>
                        <td>@h.BillAmount?.ToString("C")</td>
                        <td>
                            <span class="badge @(h.BillStatus == "Paid" ? "bg-success" : "bg-danger")">
                                @h.BillStatus
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
