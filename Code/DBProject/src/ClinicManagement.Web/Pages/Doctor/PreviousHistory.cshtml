@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Previous History";
    Layout = "_DoctorLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-history"></i> Previous Patient History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Patient</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                        <th>Bill Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.PatientHistory)
                    {
                        <tr>
                            <td>@appt.Date?.ToString("yyyy-MM-dd")</td>
                            <td>@appt.PatientName</td>
                            <td>@appt.Disease</td>
                            <td>@appt.Progress</td>
                            <td>@appt.Prescription</td>
                            <td>
                                @if (appt.BillStatus == "Paid")
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else if (appt.BillStatus == "Unpaid")
                                {
                                    <span class="badge bg-danger">Unpaid</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">N/A</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.PatientHistory.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted">No previous history found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
