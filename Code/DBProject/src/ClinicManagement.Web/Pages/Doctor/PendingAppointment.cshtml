@page
@model ClinicManagement.Web.Pages.Doctor.PendingAppointmentModel
@{
    ViewData["Title"] = "Pending Appointments";
    Layout = "_DoctorLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-clock"></i> Pending Appointments</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.Success ? "success" : "danger") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.PendingAppointments)
                    {
                        <tr>
                            <td>@appt.AppointId</td>
                            <td>@appt.PatientName</td>
                            <td>@appt.Date?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <form method="post" asp-page-handler="Approve" style="display:inline;">
                                    <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="fas fa-check"></i> Approve
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Reject" style="display:inline;">
                                    <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                    <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Reject this appointment?')">
                                        <i class="fas fa-times"></i> Reject
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.PendingAppointments.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted">No pending appointments.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
