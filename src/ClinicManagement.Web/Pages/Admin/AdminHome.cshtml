@page
@model ClinicManagement.Web.Pages.Admin.AdminHomeModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
    <a href="/" class="btn btn-outline-danger btn-sm">
        <i class="fas fa-sign-out-alt me-1"></i>Logout
    </a>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body text-center">
                <i class="fas fa-user-md fa-3x mb-2"></i>
                <h4>Total Doctors</h4>
                <h2>@Model.Stats?.TotalDoctors</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body text-center">
                <i class="fas fa-users fa-3x mb-2"></i>
                <h4>Total Patients</h4>
                <h2>@Model.Stats?.TotalPatients</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white shadow">
            <div class="card-body text-center">
                <i class="fas fa-dollar-sign fa-3x mb-2"></i>
                <h4>Total Income</h4>
                <h2>@Model.Stats?.TotalIncome.ToString("C")</h2>
            </div>
        </div>
    </div>
</div>

<!-- Navigation -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-body">
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-page="/Admin/ManageClinic" class="btn btn-primary">
                        <i class="fas fa-hospital me-1"></i>Manage Clinic
                    </a>
                    <a asp-page="/Admin/DoctorRegistrationForm" class="btn btn-success">
                        <i class="fas fa-user-md me-1"></i>Add Doctor
                    </a>
                    <a asp-page="/Admin/AddStaff" class="btn btn-info text-white">
                        <i class="fas fa-user-plus me-1"></i>Add Staff
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Department Stats -->
@if (Model.Stats?.DepartmentStats?.Any() == true)
{
    <div class="card shadow mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="fas fa-building me-2"></i>Department Overview</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Department</th>
                            <th>Doctors</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dept in Model.Stats.DepartmentStats)
                        {
                            <tr>
                                <td>@dept.DeptName</td>
                                <td>@dept.DoctorCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
