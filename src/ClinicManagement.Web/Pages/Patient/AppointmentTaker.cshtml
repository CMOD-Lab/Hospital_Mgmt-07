@page "{doctorId:int}"
@model ClinicManagement.Web.Pages.Patient.AppointmentTakerModel
@{
    ViewData["Title"] = "Book Appointment";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-plus me-2"></i>Book Appointment</h2>
    <a asp-page="/Patient/TakeAppointment" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

@if (!Model.FreeSlots.Any())
{
    <div class="alert alert-warning">No free slots available for this doctor.</div>
}
else
{
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Available Slots</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" name="doctorId" value="@Model.DoctorId" />
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead class="table-dark">
                            <tr><th>Select</th><th>Date/Time</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var slot in Model.FreeSlots)
                            {
                                <tr>
                                    <td>
                                        <input type="radio" name="slotId" value="@slot.AppointId" required />
                                    </td>
                                    <td>@slot.Date?.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-check me-1"></i>Confirm Appointment
                </button>
            </form>
        </div>
    </div>
}
