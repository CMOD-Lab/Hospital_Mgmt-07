@page
@model ClinicManagement.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Today's Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-day me-2"></i>Today's Appointments</h2>
    <a asp-page="/Doctor/DoctorHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (!Model.Appointments.Any())
{
    <div class="alert alert-info">No appointments for today.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Time</th>
                    <th>Disease</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model.Appointments)
                {
                    <tr>
                        <td>@appt.AppointId</td>
                        <td>@appt.PatientName</td>
                        <td>@appt.Timings</td>
                        <td>@appt.Disease</td>
                        <td>
                            <a asp-page="/Doctor/HistoryUpdate"
                               asp-route-appointmentId="@appt.AppointId"
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-edit"></i> Update
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
