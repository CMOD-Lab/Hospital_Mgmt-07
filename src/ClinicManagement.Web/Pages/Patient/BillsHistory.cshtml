@page
@model ClinicManagement.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-invoice-dollar me-2"></i>Bills History</h2>
    <a asp-page="/Patient/PatientHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (!Model.Bills.Any())
{
    <div class="alert alert-info">No bill history found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Appointment ID</th>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bill in Model.Bills)
                {
                    <tr>
                        <td>@bill.AppointId</td>
                        <td>@bill.DoctorName</td>
                        <td>@bill.Date?.ToString("yyyy-MM-dd")</td>
                        <td>@bill.BillAmount?.ToString("C")</td>
                        <td>
                            <span class="badge @(bill.BillStatus == "Paid" ? "bg-success" : "bg-danger")">
                                @bill.BillStatus
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
