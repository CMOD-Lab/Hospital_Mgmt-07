@page
@model ClinicManagement.Web.Pages.Admin.ManageClinicModel
@{
    ViewData["Title"] = "Manage Clinic";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-cog"></i> Manage Clinic</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.Success ? "success" : "danger") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search and Filter -->
<div class="card shadow mb-4">
    <div class="card-header">
        <h5><i class="fas fa-search"></i> Search</h5>
    </div>
    <div class="card-body">
        <form method="get">
            <div class="row">
                <div class="col-md-4 mb-2">
                    <select name="searchType" class="form-select">
                        <option value="doctor" selected="@(Model.SearchType == "doctor")">Doctors</option>
                        <option value="patient" selected="@(Model.SearchType == "patient")">Patients</option>
                        <option value="staff" selected="@(Model.SearchType == "staff")">Staff</option>
                    </select>
                </div>
                <div class="col-md-6 mb-2">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by name..." />
                </div>
                <div class="col-md-2 mb-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Doctors Table -->
@if (Model.SearchType == "doctor")
{
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5><i class="fas fa-user-md"></i> Doctors</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doctor in Model.Doctors)
                        {
                            <tr>
                                <td>@doctor.DoctorId</td>
                                <td>@doctor.Name</td>
                                <td>@doctor.Department</td>
                                <td>
                                    <form method="post" asp-page-handler="DeleteDoctor" style="display:inline;">
                                        <input type="hidden" name="doctorId" value="@doctor.DoctorId" />
                                        <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to remove this doctor?')">
                                            <i class="fas fa-trash"></i> Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Patients Table -->
@if (Model.SearchType == "patient")
{
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h5><i class="fas fa-users"></i> Patients</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Phone</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model.Patients)
                        {
                            <tr>
                                <td>@patient.PatientId</td>
                                <td>@patient.Name</td>
                                <td>@patient.Phone</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Staff Table -->
@if (Model.SearchType == "staff")
{
    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h5><i class="fas fa-id-badge"></i> Staff</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Designation</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var staff in Model.Staff)
                        {
                            <tr>
                                <td>@staff.StaffId</td>
                                <td>@staff.Name</td>
                                <td>@staff.Designation</td>
                                <td>
                                    <form method="post" asp-page-handler="DeleteStaff" style="display:inline;">
                                        <input type="hidden" name="staffId" value="@staff.StaffId" />
                                        <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to remove this staff member?')">
                                            <i class="fas fa-trash"></i> Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
