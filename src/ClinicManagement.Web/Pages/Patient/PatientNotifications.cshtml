@page
@model ClinicManagement.Web.Pages.Patient.PatientNotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-bell me-2"></i>Notifications</h2>
    <a asp-page="/Patient/PatientHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (Model.Notification == null)
{
    <div class="alert alert-info">No new notifications.</div>
}
else
{
    <div class="card shadow border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-bell me-2"></i>Appointment Update</h5>
        </div>
        <div class="card-body">
            <p><strong>Doctor:</strong> @Model.Notification.DoctorName</p>
            <p><strong>Time:</strong> @Model.Notification.Timings</p>
            <p><strong>Status:</strong> @Model.Notification.Status</p>
        </div>
    </div>
}
