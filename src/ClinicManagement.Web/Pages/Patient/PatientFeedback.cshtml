@page
@model ClinicManagement.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-star me-2"></i>Give Feedback</h2>
    <a asp-page="/Patient/PatientHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (Model.PendingFeedback == null)
{
    <div class="alert alert-info">No pending feedback at this time.</div>
}
else
{
    <div class="card shadow">
        <div class="card-header bg-warning">
            <h5 class="mb-0">Pending Feedback</h5>
        </div>
        <div class="card-body">
            <p><strong>Doctor:</strong> @Model.PendingFeedback.DoctorName</p>
            <p><strong>Appointment Time:</strong> @Model.PendingFeedback.Timings</p>
            <form method="post">
                <input type="hidden" name="appointmentId" value="@Model.PendingFeedback.AppointId" />
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-thumbs-up me-1"></i>Submit Feedback
                </button>
            </form>
        </div>
    </div>
}
