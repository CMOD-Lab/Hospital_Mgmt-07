@page
@model ClinicManagement.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-history me-2"></i>Treatment History</h2>
    <a asp-page="/Patient/PatientHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (!Model.History.Any())
{
    <div class="alert alert-info">No treatment history found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Doctor</th>
                    <th>Disease</th>
                    <th>Progress</th>
                    <th>Prescription</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.History)
                {
                    <tr>
                        <td>@h.Date?.ToString("yyyy-MM-dd")</td>
                        <td>@h.DoctorName</td>
                        <td>@h.Disease</td>
                        <td>@h.Progress</td>
                        <td>@h.Prescription</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
