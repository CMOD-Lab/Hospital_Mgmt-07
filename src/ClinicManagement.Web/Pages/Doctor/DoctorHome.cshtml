@page
@model ClinicManagement.Web.Pages.Doctor.DoctorHomeModel
@{
    ViewData["Title"] = "Doctor Home";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-stethoscope me-2"></i>Welcome, Dr. @Model.DoctorInfo?.Name</h2>
    <a href="/" class="btn btn-outline-danger btn-sm">
        <i class="fas fa-sign-out-alt me-1"></i>Logout
    </a>
</div>

@if (Model.DoctorInfo != null)
{
    <div class="row mb-4">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-user-md me-2"></i>My Profile</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr><th>Department:</th><td>@Model.DoctorInfo.DepartmentName</td></tr>
                        <tr><th>Specialization:</th><td>@Model.DoctorInfo.Specialization</td></tr>
                        <tr><th>Qualification:</th><td>@Model.DoctorInfo.Qualification</td></tr>
                        <tr><th>Experience:</th><td>@Model.DoctorInfo.WorkExperience years</td></tr>
                        <tr><th>Charges/Visit:</th><td>@Model.DoctorInfo.ChargesPerVisit.ToString("C")</td></tr>
                        <tr><th>Patients Treated:</th><td>@Model.DoctorInfo.PatientsTreated</td></tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-tasks me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-page="/Doctor/PendingAppointment" class="btn btn-warning">
                            <i class="fas fa-clock me-1"></i>Pending Appointments
                        </a>
                        <a asp-page="/Doctor/PatientHistory" class="btn btn-primary">
                            <i class="fas fa-calendar-day me-1"></i>Today's Appointments
                        </a>
                        <a asp-page="/Doctor/Bill" class="btn btn-info text-white">
                            <i class="fas fa-file-invoice-dollar me-1"></i>Generate Bill
                        </a>
                        <a asp-page="/Doctor/PreviousHistory" class="btn btn-secondary">
                            <i class="fas fa-history me-1"></i>Patient History
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
