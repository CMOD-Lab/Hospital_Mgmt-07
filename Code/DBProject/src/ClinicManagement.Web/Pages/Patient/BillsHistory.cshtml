@page
@model ClinicManagement.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
    Layout = "_PatientLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-file-invoice-dollar"></i> Bills History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Doctor</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model.BillHistory)
                    {
                        <tr>
                            <td>@bill.Date?.ToString("yyyy-MM-dd")</td>
                            <td>@bill.DoctorName</td>
                            <td>$@bill.BillAmount?.ToString("N2")</td>
                            <td>
                                @if (bill.BillStatus == "Paid")
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Unpaid</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.BillHistory.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted">No bill history found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
