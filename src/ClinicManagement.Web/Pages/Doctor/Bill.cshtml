@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Generate Bill";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-invoice-dollar me-2"></i>Generate Bill</h2>
    <a asp-page="/Doctor/DoctorHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (!Model.Appointments.Any())
{
    <div class="alert alert-info">No billable appointments for today.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model.Appointments)
                {
                    <tr>
                        <td>@appt.AppointId</td>
                        <td>@appt.PatientName</td>
                        <td>@appt.Date?.ToString("yyyy-MM-dd")</td>
                        <td>@appt.BillAmount?.ToString("C")</td>
                        <td>@appt.BillStatus</td>
                        <td>
                            <form method="post" asp-page-handler="Paid" style="display:inline">
                                <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                <button type="submit" class="btn btn-success btn-sm">Paid</button>
                            </form>
                            <form method="post" asp-page-handler="Unpaid" style="display:inline">
                                <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                <button type="submit" class="btn btn-danger btn-sm">Unpaid</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
