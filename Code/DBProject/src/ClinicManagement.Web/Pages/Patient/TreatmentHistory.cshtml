@page
@model ClinicManagement.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
    Layout = "_PatientLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-history"></i> Treatment History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Doctor</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.TreatmentHistory)
                    {
                        <tr>
                            <td>@appt.Date?.ToString("yyyy-MM-dd")</td>
                            <td>@appt.DoctorName</td>
                            <td>@appt.Disease</td>
                            <td>@appt.Progress</td>
                            <td>@appt.Prescription</td>
                        </tr>
                    }
                    @if (!Model.TreatmentHistory.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted">No treatment history found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
