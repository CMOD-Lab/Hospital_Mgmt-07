@page
@model ClinicManagement.Web.Pages.Doctor.PendingAppointmentModel
@{
    ViewData["Title"] = "Pending Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-clock me-2"></i>Pending Appointments</h2>
    <a asp-page="/Doctor/DoctorHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

@if (!Model.Appointments.Any())
{
    <div class="alert alert-info">No pending appointments.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Date/Time</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model.Appointments)
                {
                    <tr>
                        <td>@appt.AppointId</td>
                        <td>@appt.PatientName</td>
                        <td>@appt.Date?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <form method="post" asp-page-handler="Approve" style="display:inline">
                                <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fas fa-check"></i> Approve
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Reject" style="display:inline">
                                <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Reject this appointment?')">
                                    <i class="fas fa-times"></i> Reject
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
