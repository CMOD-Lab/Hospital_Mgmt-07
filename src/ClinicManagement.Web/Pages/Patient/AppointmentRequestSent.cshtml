@page
@model ClinicManagement.Web.Pages.Patient.AppointmentRequestSentModel
@{
    ViewData["Title"] = "Appointment Request Sent";
}

<div class="text-center mt-5">
    <div class="card shadow mx-auto" style="max-width: 500px;">
        <div class="card-body py-5">
            <i class="fas fa-check-circle text-success fa-5x mb-3"></i>
            <h3>Appointment Request Sent!</h3>
            <p class="text-muted">Your appointment request has been submitted. Please wait for the doctor's approval.</p>
            <a asp-page="/Patient/PatientHome" class="btn btn-primary mt-3">
                <i class="fas fa-home me-1"></i>Back to Home
            </a>
        </div>
    </div>
</div>
